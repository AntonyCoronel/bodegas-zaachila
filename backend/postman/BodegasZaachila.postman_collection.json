            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bodegaId\": 2,\n  \"nombre\": \"Ana\",\n  \"telefono\": \"951 000 0000\",\n  \"correo\": \"ana@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
