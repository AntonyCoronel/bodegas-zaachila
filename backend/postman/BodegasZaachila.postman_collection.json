            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bodega Extra Grande\",\n  \"volumen\": 20,\n  \"precio\": 2299,\n  \"estado\": \"Ocupada\",\n  \"descripcion\": \"Espacio amplio para mudanzas completas.\",\n  \"cliente\": {\n    \"nombre\": \"Familia López\",\n    \"telefono\": \"951 000 0005\",\n    \"correo\": \"lopez@example.com\"\n  }\n}",
