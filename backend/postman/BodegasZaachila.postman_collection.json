              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene teléfono', () => pm.expect(pm.response.json().telefono).to.be.a('string'));"
                ]
