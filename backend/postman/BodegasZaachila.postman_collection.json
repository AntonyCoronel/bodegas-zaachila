              "raw": "{\n  \"nombre\": \"Bodega Extra Grande\",\n  \"volumen\": 20,\n  \"precio\": 2299,\n  \"estado\": \"Vendida\",\n  \"descripcion\": \"Estado que no existe\"\n}",
