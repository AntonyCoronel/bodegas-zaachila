            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bodega Extra Grande\",\n  \"volumen\": 0,\n  \"precio\": -10,\n  \"estado\": \"Disponible\",\n  \"descripcion\": \"Datos inválidos\"\n}",
